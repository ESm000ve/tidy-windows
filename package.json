{
  "name": "tidy",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:win",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:publish": "node scripts/check-publish.mjs",
    "verify": "node scripts/verify.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test": "node scripts/smoke-test.mjs",
    "build:app": "vite build",
    "build:win": "vite build && node scripts/prepare-windows.mjs && electron-builder --win nsis --x64 --publish never",
    "build:win:unpacked": "vite build && node scripts/prepare-windows.mjs && electron-builder --win --x64 --dir --publish never",
    "test:files": "node scripts/file-tests.mjs",
    "test:duplicates": "node scripts/duplicate-tests.mjs",
    "test:features": "node scripts/feature-tests.mjs",
    "test:features:desktop": "node scripts/features-desktop-test.mjs",
    "test:desktop": "node scripts/desktop-test.mjs",
    "test:a11y": "node scripts/audit.mjs",
    "test:fluent": "node scripts/fluent-test.mjs",
    "test:subfolders": "node scripts/subfolder-tests.mjs",
    "test:subfolders:desktop": "node scripts/subfolder-desktop-test.mjs",
    "test:source-choices": "node scripts/source-choices-desktop-test.mjs",
    "test:key": "node scripts/key-test.mjs",
    "test:ai": "node scripts/ai-test.mjs",
    "test:books": "node scripts/books-desktop-test.mjs",
    "test:native:windows": "node scripts/native-windows-test.mjs"
  },
  "build": {
    "appId": "com.ericauzenne.tidy",
    "productName": "Tidy",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "release",
      "app": "build/windows-app"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "!**/._*",
      "!node_modules/**/*"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "Tidy-Windows-${version}-${arch}-Setup.${ext}"
    },
    "nsis": {
      "include": "installer/windows-hooks.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "npmRebuild": false
  },
  "devDependencies": {
    "@fluentui/react-icons": "^2.0.344",
    "@google/genai": "^1.43.0",
    "@playwright/test": "^1.64.1",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-switch": "1.1.3",
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^25.3.3",
    "@types/node-schedule": "^2.1.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "^4.14.0",
    "clsx": "^2.1.1",
    "date-fns": "3.6.0",
    "dotenv": "^17.3.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.8.1",
    "motion": "12.23.24",
    "next-themes": "0.4.6",
    "node-schedule": "^2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.1.12",
    "tw-animate-css": "1.3.8",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-electron": "^0.29.0"
  },
  "description": "File organization with preview, reversible moves, and AI-assisted rules.",
  "license": "MIT",
  "homepage": "https://github.com/ESm000ve/tidy-windows#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ESm000ve/tidy-windows.git"
  },
  "bugs": {
    "url": "https://github.com/ESm000ve/tidy-windows/issues"
  },
  "author": "Eric Auzenne"
}
